"""Seed candidate for the K4 cipher-search evolution.

ONLY this file is mutated by the LLM (between the EVOLVE-BLOCK markers).
The shinka_adapter AST gate enforces a strict allowlist on this file, so
everything not strictly required for the EVOLVE block lives in
``problem/_fitness.py`` instead. We keep this file minimal: a few safe
imports, a single ``run_experiment`` wrapper that delegates scoring, and
the EVOLVE block itself.

Allowlist (set in configs/config.yaml -> ast_check.allowed_imports):
    __future__, numpy, math, typing, collections, kryptos, problem
"""

from __future__ import annotations

from typing import Any

from problem._fitness import (
    count_crib_letter_hits,
    find_crib_literal_cheat,
    now,
    score_plaintext,
)


# Threshold for the sentinel-also-scores reward-hack guard. Random
# expectation for crib hits in a single uniform A-Z 97-char string is
# 24/26 = 0.92. For a multi-hypothesis dispatcher that picks one of N
# cipher candidates by English-likeness, the max crib-hit count across
# those candidates can run higher by chance:
#   N=100  P(any candidate hits >= k):  k=5: 2%,   k=6: 0.16%, k=7: 0.008%
#   N=500  P(any candidate hits >= k):  k=5: 10%,  k=6: 0.8%,  k=7: 0.04%
# We had a confirmed false positive at threshold=4 during the k4_full_v1
# run (gen 174: honest ~150-candidate dispatcher with sentinel_hits=5).
# Threshold > 6 keeps the catch rate for actual cheaters at ~100% (a
# hardcoder hits all 24) while keeping false-positive rate negligible
# even for very large dispatchers.
_SENTINEL_CRIB_HITS_THRESHOLD = 6


def run_experiment(*, instance: dict[str, Any], seed: int, **kwargs: Any) -> dict[str, Any]:
    """Score the EVOLVE block's decrypt_k4 against the K4 ciphertext.

    Reward-hack guards layered before scoring:

      1. Source scan: reject if the EVOLVE-block function source contains
         all four crib literals, or both "EAST" and "NORTHEAST"
         (find_crib_literal_cheat).
      2. Differential input: call decrypt_k4 on K4 AND on reversed-K4. If
         the two outputs share >50% positions, the function ignores its
         argument (hardcoded plaintext).
      3. Sentinel cribs: even when outputs differ, if decrypt_k4 of the
         reversed sentinel also hits cribs at the K4 positions, the cribs
         are coming from code (stitched-after-cipher, branchy lookup).
         Random expectation is ~0.92 hits; we reject above 4.

    Returns the EvalResult dict shinka expects:
      score (higher better), solved (bool), runtime_s, metadata, error_tail.
    """
    t0 = now()
    ciphertext = instance["ciphertext"]

    literal_err = find_crib_literal_cheat(decrypt_k4)
    if literal_err is not None:
        return {
            "score": float("-inf"),
            "solved": True,
            "runtime_s": now() - t0,
            "error_tail": literal_err,
        }

    try:
        plaintext = decrypt_k4(ciphertext)
    except Exception as e:
        return {
            "score": float("-inf"),
            "solved": True,
            "runtime_s": now() - t0,
            "error_tail": f"{type(e).__name__}: {e}",
        }

    sentinel = ciphertext[::-1]
    try:
        plaintext_sentinel = decrypt_k4(sentinel)
    except Exception as e:
        return {
            "score": float("-inf"),
            "solved": True,
            "runtime_s": now() - t0,
            "error_tail": (
                "decrypt_k4 crashes on reversed-ciphertext sentinel "
                "(non-robust to input): " + f"{type(e).__name__}: {e}"
            ),
        }

    if (
        isinstance(plaintext, str)
        and isinstance(plaintext_sentinel, str)
        and len(plaintext) == len(plaintext_sentinel)
        and len(plaintext) > 0
    ):
        same = sum(1 for a, b in zip(plaintext, plaintext_sentinel) if a == b)
        identity_ratio = same / len(plaintext)
        if identity_ratio > 0.5:
            return {
                "score": float("-inf"),
                "solved": True,
                "runtime_s": now() - t0,
                "error_tail": (
                    f"decrypt_k4 appears to ignore its ciphertext argument: "
                    f"{identity_ratio:.0%} identical positions between K4 "
                    f"and reversed-K4 outputs (real cipher should produce "
                    f"~4% identity; >50% means hardcoded plaintext)."
                ),
            }

        sentinel_hits = count_crib_letter_hits(plaintext_sentinel)
        if sentinel_hits > _SENTINEL_CRIB_HITS_THRESHOLD:
            return {
                "score": float("-inf"),
                "solved": True,
                "runtime_s": now() - t0,
                "error_tail": (
                    f"decrypt_k4 produces crib letters at the K4 crib "
                    f"positions even on reversed-ciphertext input "
                    f"({sentinel_hits} of 24 hits, random expectation "
                    f"~1). Cribs are coming from code structure, not "
                    f"from the cipher transforming K4."
                ),
            }

    return score_plaintext(plaintext, t0=t0)


